      "changedAt": "2026-10-23T14:03:43.881Z",
      "sourceRunId": "b3bb0397-7926-4ccf-be43-e364b9f78590",
      "changeType": "new",
      "active": true,
      "paragraphs": [],
      "keyPoints": [
        "Most Yellowstone National Park roads and entrances close for the winter season on Nov. 1, 2026."
      ],
      "takeaway": "If you plan to drive into or through Yellowstone, schedule it before Nov. 1, 2026; after that date most roads and entrances are closed for the winter season."
    },
