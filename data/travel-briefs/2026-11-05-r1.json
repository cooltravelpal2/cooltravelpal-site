    {
      "storyId": "offer_f5b38390ad8f5497add58c48",
      "storyRevision": 1,
      "section": "airlines",
      "rank": 79,
      "title": "Frequent Miler: $200 Back on $900+ Airfare for Marriott Brilliant Cardholders",
      "summary": "Frequent Miler reports that targeted Marriott Bonvoy Brilliant American Express cardholders are receiving an Amex Offer for a $200 statement credit after $900 or more in airfare purchases. Eligible flights must be booked directly with airlines, can be spread across multiple purchases, and the offer expires Feb. 28, 2027. Third-party bookings, packages, charter flights, inflight purchases and airport charges are excluded; purchases must be in USD.",
      "verification": "reported",
      "sourcePublishedAt": "2026-11-04T20:45:43.000Z",
      "effectiveAt": null,
      "sources": [
        {
          "publisher": "Frequent Miler",
          "url": "https://frequentmiler.com/airfare-amex-offer-on-marriott-brilliant-cards-get-200-back-when-spending-900/",
          "sourceType": "editorial",
          "publishedAt": "2026-11-04T20:45:43.000Z",
          "retrievedAt": "2026-11-05T15:01:46.684Z"
        }
      ],
      "terms": {
        "issuer": "American Express",
        "program": "Amex Offers",
        "merchant": "Airlines (direct bookings)",
        "rewardType": "statement_credit",
        "minSpend": 900,
        "creditAmount": 200,
        "rewardPoints": null,
        "activationRequired": null,
        "activateBy": null
      },
      "expiresAt": "2027-02-28T23:59:59.000Z",
      "firstSeenAt": "2026-11-05T15:03:53.165Z",
      "changedAt": "2026-11-05T15:03:53.165Z",
      "sourceRunId": "18853a5a-e6b6-4dfe-94f1-1944d31a1389",
      "changeType": "new",
      "active": true,
      "paragraphs": [
        "Frequent Miler reports the offer is limited to targeted Marriott Bonvoy Brilliant American Express cardholders. The $900 minimum can be met through one or more airfare purchases, and the $200 comes as a statement credit. Bookings must be made directly with scheduled passenger airlines—online, through the airline app, by phone or at a ticket counter—and the offer expires Feb. 28, 2027.",
        "The reported exclusions cover third-party booking sites and travel agencies, charter or private jet flights, vacation or travel packages, inflight purchases, gift cards, buying miles or points, and airport retail, dining or lounge charges. Purchases must be made in US dollars, and any Membership Rewards points, credits or miles used to pay part of the fare will not count toward the $900 minimum."
      ],
      "keyPoints": [
        "$200 statement credit after $900+ in eligible airfare, across one or more purchases.",
        "Book directly with scheduled passenger airlines; third-party sites, packages, charter flights and airport charges are excluded.",
        "Purchases must be in USD; points, credits or miles used toward the fare do not count toward the minimum."
      ],
      "takeaway": "Check whether the offer is on your Marriott Bonvoy Brilliant card, then book eligible flights directly with the airline in USD. Multiple bookings can count toward the $900 threshold through Feb. 28, 2027."
    },
    {
