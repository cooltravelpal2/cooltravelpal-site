  "stories": [
    {
      "storyId": "offer_036a5e42d9315d3cec059e42",
      "storyRevision": 1,
      "section": "airlines",
      "rank": 79,
      "title": "Amex Offer: $200 back on $2,500 in Virgin Atlantic flights",
      "summary": "Frequent Miler reports a new targeted Amex Offer for Virgin Atlantic: add the offer, then spend $2,500 or more on eligible Virgin Atlantic-marketed flights and get a $200 statement credit. Bookings must be made directly with Virgin Atlantic online or in its app, originate in the US and be charged in USD. The offer excludes ticket-desk, call-center, in-flight, luggage and meal purchases and is limited to one credit per eligible card account.",
      "verification": "reported",
      "sourcePublishedAt": "2026-10-23T19:45:41.000Z",
      "effectiveAt": null,
      "sources": [
        {
          "publisher": "Frequent Miler",
          "url": "https://frequentmiler.com/get-200-back-on-virgin-atlantic-flights-with-new-amex-offer/",
          "sourceType": "editorial",
          "publishedAt": "2026-10-23T19:45:41.000Z",
          "retrievedAt": "2026-10-24T14:01:42.641Z"
        }
      ],
      "terms": {
        "issuer": "American Express",
        "program": "Amex Offers",
        "merchant": "Virgin Atlantic",
        "rewardType": "statement_credit",
        "minSpend": 2500,
        "creditAmount": 200,
        "rewardPoints": null,
        "activationRequired": true,
        "activateBy": null
      },
      "expiresAt": null,
      "firstSeenAt": "2026-10-24T14:03:03.147Z",
      "changedAt": "2026-10-24T14:03:03.147Z",
      "sourceRunId": "c5949189-2a33-4a08-a187-f4ce798b03ec",
      "changeType": "new",
      "active": true,
      "paragraphs": [
        "The offer requires enrollment before the qualifying purchase and applies only to cards issued in the US. It covers one-way and round-trip Virgin Atlantic-marketed flights paid for during the offer period, which the report did not date. The statement credit is limited to one per eligible Card Member account.",
        "Frequent Miler suggests the terms may also help with award-ticket surcharges because they do not expressly exclude award bookings, but that reading is not confirmed. Purchases must be direct with Virgin Atlantic; ticket-desk, call-center, in-flight, luggage and meal charges are excluded."
      ],
      "keyPoints": [
        "Spend $2,500 or more on eligible Virgin Atlantic flights to earn a $200 statement credit.",
        "Flights must originate in the US, be booked directly online or in the app, and be charged in USD.",
        "Enrollment is required; the credit is limited to one per eligible card account and US-issued cards only."
      ],
      "takeaway": "If the offer appears on your Amex account, add it before booking a direct Virgin Atlantic flight that originates in the US and is charged in USD; use the enrolled card and avoid call-center or ticket-desk bookings."
    }
